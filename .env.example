# BM Grammar School — environment configuration
# Copy to .env and fill in real values. Never commit secrets.

# SQLite database file path (relational store)
DATABASE_URL=file:./data/bmgs.db

# Secret used to sign session tokens (generate a long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional transactional email (used for welcome / reset / application emails).
# When unset, email delivery is disabled and reset links are written to data/outbox.log
EMAIL_SERVER=
EMAIL_FROM="BM Grammar School <no-reply@bmgrammar.example>"

# Optional: email address that receives ADMIN role upon registration.
# Leave empty in production unless an administrator account is required.
ADMIN_EMAIL=

# Optional map API key if a hosted map provider is integrated later.
MAP_API_KEY=
